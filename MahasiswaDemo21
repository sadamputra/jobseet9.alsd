package jobsheet9;

import java.util.Scanner;

public class MahasiswaDemo21 {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        StackTugasMahasiswa21 stack = new StackTugasMahasiswa21(5);
        int pilih;

        do {
            System.out.println("\n==== MENU ====");
            System.out.println("1. Tambah Tugas");
            System.out.println("2. Nilai & Hapus Tugas");
            System.out.println("3. Lihat Tugas Terakhir");
            System.out.println("4. Lihat Semua Tugas");
            System.out.println("5. Lihat Tugas Pertama");
            System.out.println("6. Hitung Tugas");
            System.out.println("0. Keluar");
            System.out.print("Pilih: ");
            pilih = scan.nextInt(); scan.nextLine();

            switch (pilih) {
                case 1:
                    System.out.print("NIM: ");
                    String nim = scan.nextLine();
                    System.out.print("Nama: ");
                    String nama = scan.nextLine();
                    System.out.print("Kelas: ");
                    String kelas = scan.nextLine();
                    stack.push(new Mahasiswa21(nim, nama, kelas));
                    break;

                case 2:
                    Mahasiswa21 mhs = stack.pop();
                    if (mhs != null) {
                        System.out.print("Masukkan nilai tugas: ");
                        int nilai = scan.nextInt();
                        mhs.tugasDinilai(nilai);
                        System.out.println("Tugas telah dinilai:");
                        mhs.tampilData();
                    }
                    break;

                case 3:
                    Mahasiswa21 atas = stack.peek();
                    if (atas != null) {
                        System.out.println("Tugas Terakhir:");
                        atas.tampilData();
                    }
                    break;

                case 4:
                    System.out.println("Semua Tugas:");
                    stack.print();
                    break;

                case 5:
                    Mahasiswa21 bawah = stack.peekBottom();
                    if (bawah != null) {
                        System.out.println("Tugas Pertama:");
                        bawah.tampilData();
                    }
                    break;

                case 6:
                    System.out.println("Jumlah tugas: " + stack.count());
                    break;

                case 0:
                    System.out.println("Keluar program.");
                    break;
            }

        } while (pilih != 0);
    }
}
